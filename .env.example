# Public site URL (canonical, sitemap, JSON-LD)
NEXT_PUBLIC_SITE_URL=https://www.majidmemari.com

# ─── Vercel AI Gateway (site and course assistants) ───
# Auth is automatic on Vercel deployments via OIDC.
# Local dev: `vercel link` then `vercel env pull .env.local` provisions VERCEL_OIDC_TOKEN (~24h).
# Optional CI fallback (non-Vercel envs):
# AI_GATEWAY_API_KEY=

# Optional model overrides — must use `provider/model` slug routed via AI Gateway.
# Site chatbot and contact classifier default to openai/gpt-oss-20b.
# Workshop TA default is anthropic/claude-haiku-4.5 (see below).
# See https://vercel.com/docs/ai-gateway for the model list.
AI_CHAT_MODEL=openai/gpt-oss-20b
CONTACT_CLASSIFY_MODEL=openai/gpt-oss-20b

# Workshop teaching assistant (/teaching/agentic-llm → /api/workshop-chat)
# Optional. Default: anthropic/claude-haiku-4.5 via AI Gateway.
# WORKSHOP_TA_MODEL=anthropic/claude-haiku-4.5
# Optional room code. When unset, the workshop assistant is public.
# Do not commit a real code.
# WORKSHOP_TA_CODE=

# Building AI Solutions (/teaching/ai-solutions/assistant → /api/course-chat)
# Uses COURSE_TA_MODEL, then WORKSHOP_TA_MODEL, then the default below.
# COURSE_TA_MODEL=anthropic/claude-haiku-5.5
# Optional access code; when unset, the course assistant is public.
# COURSE_TA_CODE=

# Email — optional; without RESEND_API_KEY, contact form logs server-side only
RESEND_API_KEY=
# Must be a verified sender in Resend, e.g. Majid Memari <hello@majidmemari.com>
RESEND_FROM_EMAIL=
CONTACT_TO_EMAIL=memari.majid@hotmail.com
