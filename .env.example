# Public site URL (canonical, sitemap, JSON-LD)
NEXT_PUBLIC_SITE_URL=https://www.majidmemari.com

# Try My AI: public URLs for linked apps in the Work section
NEXT_PUBLIC_AI_CPA_URL=
NEXT_PUBLIC_AI_TA_URL=

# ─── Vercel AI Gateway (chatbot + contact-form classifier) ───
# Auth is automatic on Vercel deployments via OIDC.
# Local dev: `vercel link` then `vercel env pull .env.local` provisions VERCEL_OIDC_TOKEN (~24h).
# Optional CI fallback (non-Vercel envs):
# AI_GATEWAY_API_KEY=

# Optional model overrides. Must use a `provider/model` slug routed via AI Gateway.
# Chat default (code and production): anthropic/claude-opus-5. Classifier default: openai/gpt-oss-20b. See https://vercel.com/docs/ai-gateway for the model list.
AI_CHAT_MODEL=anthropic/claude-opus-5
CONTACT_CLASSIFY_MODEL=openai/gpt-oss-20b

# Email (optional). BOTH RESEND_API_KEY and RESEND_FROM_EMAIL are required for a send;
# with either missing, the contact form and the chat hand-off log server-side only and
# Dr. MJ tells the visitor the email was not sent.
RESEND_API_KEY=
# Must be a verified sender in Resend, e.g. Majid Memari <hello@majidmemari.com>
RESEND_FROM_EMAIL=
# The one inbox that receives site mail (contact form, chat hand-off, reply-to).
CONTACT_TO_EMAIL=memari.majid@hotmail.com

# ─── Chat limits: Upstash Redis over REST (durable rate limit, spend budgets, email caps) ───
# Install Upstash from the Vercel Marketplace with NO custom env prefix; it writes KV_REST_API_*.
# The plain UPSTASH_REDIS_REST_* names are the manual alternative and are read second.
# Without either pair the counters live in per-instance memory (fine for local dev only).
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
